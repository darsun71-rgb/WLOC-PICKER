#!name=WLOC Location Spoofer
#!desc=Spoofs the coordinates Apple network location (WLOC) returns to iOS. Response-rewriting script by the community-maintained zxishere/wloc project.
#!author=Built for personal use from zxishere/wloc
#!homepage=https://github.com/zxishere/wloc
#!category=Tools

[Script]
WLOC Spoof = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,timeout=30,script-path=https://raw.githubusercontent.com/zxishere/wloc/main/wloc.js,argument=longitude=113.94114&latitude=22.544577&accuracy=25&randomRadius=0&logLevel=info
WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,timeout=10,script-path=https://raw.githubusercontent.com/zxishere/wloc/main/wloc-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
